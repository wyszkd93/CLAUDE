{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/persona-engine/persona.schema.json",
  "title": "Persona",
  "description": "페르소나 정의 v0.1 초안. 말투·고정 대사·안전 불변식·평가 프로브를 한 파일에 담는다.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "locale", "identity", "style", "safety"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$", "description": "BCP 47. 예: ko, ko-KR, en-US" },

    "identity": {
      "type": "object",
      "required": ["intro", "persona"],
      "additionalProperties": false,
      "properties": {
        "intro": { "type": "string", "description": "시스템 프롬프트 첫 문장. 예: 너는 ○○다." },
        "persona": { "type": "string", "description": "배경·성격·관심사. 사실 주장은 넣지 않는다." },
        "knowledgeBoundary": { "type": "string", "description": "모르는 것을 지어내지 않는다는 등의 경계." }
      }
    },

    "style": {
      "type": "object",
      "required": ["tone"],
      "additionalProperties": false,
      "properties": {
        "tone": { "type": "string", "description": "말투 지시문." },
        "register": { "enum": ["formal", "polite", "casual", "mixed"] },
        "maxSentences": { "type": "integer", "minimum": 1, "maximum": 20 },
        "dos": { "type": "array", "items": { "type": "string" } },
        "donts": { "type": "array", "items": { "type": "string" } },
        "examples": {
          "type": "array",
          "description": "few-shot 대화 예시.",
          "items": {
            "type": "object",
            "required": ["user", "assistant"],
            "additionalProperties": false,
            "properties": {
              "user": { "type": "string" },
              "assistant": { "type": "string" },
              "context": { "type": "string" }
            }
          }
        }
      }
    },

    "flair": {
      "type": "object",
      "description": "결정적 후처리: 응답 앞뒤에 감정별 말머리·말꼬리를 붙인다.",
      "additionalProperties": false,
      "properties": {
        "everyN": { "type": "integer", "minimum": 1, "default": 4, "description": "N번에 한 번 붙인다(seed 해시로 결정)." },
        "lead": { "$ref": "#/$defs/moodLines" },
        "tail": { "$ref": "#/$defs/moodLines" },
        "skipKinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/messageKind" },
          "default": ["error", "approval", "progress"],
          "description": "이 종류의 메시지에는 flair를 붙이지 않는다."
        }
      }
    },

    "canned": {
      "type": "object",
      "description": "AI 없이도 쓰는 고정 대사. 키는 이벤트 이름.",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_:.-]{0,47}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["lines"],
        "additionalProperties": false,
        "properties": {
          "lines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "vars": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" }, "description": "lines 안의 {name} 자리표시자 목록." }
        }
      }
    },

    "safety": {
      "type": "object",
      "required": ["invariants"],
      "additionalProperties": false,
      "properties": {
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "말투·성격 때문에 어길 수 없는 규칙. 항상 프롬프트 마지막에 붙는다."
        },
        "styledFields": {
          "type": "array",
          "items": { "type": "string" },
          "description": "구조화 출력에서 페르소나를 적용해도 되는 필드(예: reply, bubble)."
        },
        "untouchedFields": {
          "type": "array",
          "items": { "type": "string" },
          "description": "페르소나를 적용하면 안 되는 필드(예: id, command, arguments)."
        }
      }
    },

    "assets": {
      "type": "object",
      "description": "표현 에셋 슬롯. 값은 엔진이 저장한 파일 id.",
      "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/assetRef" } }
    },

    "eval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passThreshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.9 },
        "probes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "input"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "input": { "type": "string" },
              "kind": { "$ref": "#/$defs/messageKind" },
              "mustMatch": { "type": "array", "items": { "type": "string" }, "description": "정규식. 모두 매치돼야 통과." },
              "mustNotMatch": { "type": "array", "items": { "type": "string" }, "description": "정규식. 하나라도 매치되면 실패." },
              "rubric": { "type": "string", "description": "LLM 심사용 기준(선택)." }
            }
          }
        }
      }
    }
  },

  "$defs": {
    "messageKind": { "enum": ["info", "chat", "todo", "done", "progress", "approval", "error"] },
    "mood": { "enum": ["happy", "excited", "calm", "busy"] },
    "moodLines": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/mood" },
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "assetRef": {
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "pattern": "^[a-z_]+-[a-z0-9]{8}\\.(png|jpg|webp|gif|webm|mp4)$" },
        "say": { "type": "string" }
      }
    }
  }
}
